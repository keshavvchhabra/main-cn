# ============================================================
#  TEAM CONFIG - edit this ONE file, then run ./render.sh
#  Every Mac keeps an identical copy of this repo + this file.
# ============================================================
TEAM=team1                 # your team id -> app.team1.test

MAC1_IP=10.142.107.114      # Mac 1: primary DNS (dnsmasq) + test client
MAC2_IP=10.142.107.105     # Mac 2: edge nginx (TLS + load balancer)
MAC3_IP=10.142.107.97      # Mac 3: Backend A  (+ backup DNS, standby edge in Phase 2)
MAC4_IP=10.142.107.96    # Mac 4: Backend B  + test client

BACKUP_DNS_IP=$MAC3_IP     # Phase 2 Ext A
STANDBY_EDGE_IP=$MAC3_IP   # Phase 2 Ext E

PORT_A=3001
PORT_B=3002
HTTPS_PORT=443             # use 8443 if you cannot bind 443
HTTP_PORT=80               # use 8080 if you cannot bind 80

UPSTREAM_DNS=1.1.1.1       # where dnsmasq forwards non-project names
DNS_TTL=30                 # short TTL for Ext B / Ext E

NET_SERVICE="Wi-Fi"        # see: networksetup -listallnetworkservices
IFACE=en0                  # see: route -n get default | grep interface

BREW_PREFIX=$(brew --prefix 2>/dev/null || echo /opt/homebrew)
